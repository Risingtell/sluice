# ── Sluice configuration ──────────────────────────────────────────────────────
# MOCK mode needs NOTHING set: copy to .env and run. LIVE mode needs the owner creds below.

# mock | live
MODE=mock
PORT=4021

# Hard cap on seconds billed per tick (clock-jump guard).
MAX_TICK_SECONDS=10

# ── LIVE mode only (Casper x402) ──────────────────────────────────────────────
# 1) Facilitator API key from cspr.cloud (Casper Buildathon sponsors free usage).
FACILITATOR_URL=https://x402-facilitator.cspr.cloud
FACILITATOR_API_KEY=

# 2) Networks to take payment on, default first, each with its own CEP-18 token package.
#    Testnet is free. To take mainnet payment too, set casper:casper,casper:casper-test and
#    ASSET_PACKAGE_MAINNET: every mainnet settlement costs the fee payer about 3.3 CSPR of gas.
NETWORKS=casper:casper-test
ASSET_PACKAGE_MAINNET=
ASSET_PACKAGE_TESTNET=
#    Single-network alternative (used only when NETWORKS is empty):
# CAIP2_CHAIN_ID=casper:casper-test
# ASSET_PACKAGE=
#    Optional private RPC nodes, per network:
# FACILITATOR_RPC_URL_MAINNET=
# FACILITATOR_RPC_URL_TESTNET=

# 3) Payee (a Casper account public key) and the token's display name (its EIP-712 domain name).
PAYEE_ADDRESS=
ASSET_NAME=Casper X402 Token

# ── Demo console (/demo.html) ─────────────────────────────────────────────────
# Live on-chain demo sessions allowed per UTC day: testnet, and mainnet (each mainnet session
# spends about 20 CSPR of gas, so it gets fewer).
DEMO_LIVE_SESSIONS_PER_DAY=8
DEMO_MAINNET_SESSIONS_PER_DAY=4
DEMO_TICK_MS=2000
DEMO_MAX_TICKS=6
DEMO_BUDGET_X402=0.05
# Cloud hosts only: paste the agent PEM so the server can materialize keys/agent.pem.
# AGENT_KEY_PEM=

# ── Agent (client) ────────────────────────────────────────────────────────────
SERVER_URL=http://localhost:4021
AGENT_STREAM=btc-usd
AGENT_TICK_MS=1000
AGENT_MAX_TICKS=20
# LIVE mode: PEM-encoded ed25519 private key for the agent's Casper account.
CLIENT_PRIVATE_KEY_PATH=
CLIENT_KEY_ALGO=ed25519
# Network the agent pays on. Empty: the server's first Casper offer (mainnet on a Sluice server).
# AGENT_NETWORK=casper:casper-test

# ── Faucet caps per UTC day (mainnet grants spend about 3.3 CSPR of gas each) ──
# FAUCET_PER_IP_PER_DAY=3
# FAUCET_GLOBAL_PER_DAY=40
# FAUCET_MAINNET_PER_IP_PER_DAY=1
# FAUCET_MAINNET_GLOBAL_PER_DAY=10

# Requests per minute per IP allowed to reach the facilitator's verify/settle paths (default 60).
FACILITATOR_RATE_LIMIT_PER_MINUTE=60
